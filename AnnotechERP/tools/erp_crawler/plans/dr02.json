 },
 {
  "goto": "/m/dyeing/reprocess-approval"
 },
 {
  "texts": "rpa_rows",
  "of": "main tbody tr"
 },
 {
  "html": "rpa_btns",
  "of": "main tbody tr >> nth=0 >> button, main tbody tr >> nth=0 >> a"
 },
 {
  "fullshot": "rpa-row"
 },
 {
  "goto": "/m/dyeing/print-chemical-requisition"
 },
 {
  "texts": "pc_rows",
  "of": "main tbody tr"
 },
 {
  "html": "pc_btns",
  "of": "main tbody tr >> nth=0 >> button, main tbody tr >> nth=0 >> a"
 },
 {
