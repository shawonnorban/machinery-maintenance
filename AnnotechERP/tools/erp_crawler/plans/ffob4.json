 },
 {
  "fillsel": "div:has(> label:has-text('Fab Item')) input",
  "text": "Probe item"
 },
 {
  "fillsel": "div:has(> label:has-text('Fab Color')) input",
  "text": "Navy"
 },
 {
  "fillsel": "div:has(> label:has-text('FIN. GSM')) input",
  "text": "180"
 },
 {
  "fillsel": "div:has(> label:has-text('FIN. DIA')) input",
  "text": "60"
 },
 {
  "fillsel": "div:has(> label:has-text('Batch No')) input",
  "text": "B-1"
 },
 {
  "fillsel": "div:has(> label:has-text('No Of Roll')) input",
  "text": "2"
 },
 {
  "fillsel": "div:has(> label:has-text('OB QTY')) input",
  "text": "50"
 },
 {
  "fillsel": "div:has(> label:has-text('OB COST')) input",
  "text": "10"
 },
 {
  "click": "button:has-text('Add Row')",
