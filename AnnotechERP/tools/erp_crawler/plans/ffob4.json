 },
 {
  "peek": "div:has(> label:has-text('Fab Type')) button",
  "wait": 1200
 },
 {
  "click": "[role=option]:has-text('Fleece') >> nth=0",
  "wait": 600
 },
 {
  "click": "button:has-text('Add Row')",
  "wait": 1500
 },
 {
  "choose": "div:has(> label:has-text('Fabric Group')) select",
  "label": "Body"
 },
 {
  "texts": "m2",
  "of": "main [role=alert], main p"
 },
 {
  "peek": "div:has(> label:has-text('Fab Composition')) button",
  "wait": 1200
 },
 {
  "click": "[role=option]:has-text('100% Cotton') >> nth=0",
  "wait": 600
 },
 {
  "click": "button:has-text('Add Row')",
  "wait": 1500
 },
 {
  "texts": "m3",
  "of": "main [role=alert], main p"
 },
 {
  "texts": "grid_head",
  "of": "main table thead th"
 },
 {
  "texts": "grid_row",
  "of": "main table tbody tr"
 },
 {
  "fullshot": "ffob-grid"
 },
 {
  "peek": "div:has(> label:has-text('Receiving Store')) button",
  "wait": 1200
 },
 {
  "click": "[role=option]:has-text('Finished Fabric Store') >> nth=0",
  "wait": 600
 },
 {
  "fillsel": "input[name='obDate']",
  "text": "2026-10-01"
 },
 {
  "click": "button:has-text('Save opening balance')",
  "wait": 2500
 },
 {
  "texts": "save_msgs",
  "of": "main [role=alert], main p"
 },
 {
  "fullshot": "ffob-save"
 },
 {
  "texts": "records_after",
  "of": "main table thead th, main table tbody tr"
 }
