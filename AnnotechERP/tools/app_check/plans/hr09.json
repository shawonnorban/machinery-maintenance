[
 {"goto": "/hr-payroll/letter-master"},
 {"wait": 20000},
 {"shot": "m0-initial"},
 {"fill": "New letter type", "sel": "main [aria-label='New letter type']", "text": "NOC Letter"},
 {"click": "main button:has-text('Add letter type')", "after": 12000},
 {"fill": "Letter Title", "sel": "main [aria-label='Letter Title']", "text": "No Objection Certificate"},
 {"fill": "Subject", "sel": "main [aria-label='Subject']", "text": "No Objection Certificate for passport"},
 {"fill": "Reference Format", "sel": "main [aria-label='Reference Format']", "text": "HR/NOC/{YYYY}/{SEQ}"},
 {"fill": "Salutation", "sel": "main [aria-label='Salutation (Opening)']", "text": "To whom it may concern,"},
 {"fill": "Main Body", "sel": "main [aria-label='Main Body']", "text": "This is to certify that **{{EmployeeName}}**, ID **{{EmployeeNumber}}**, has been working as **{{Designation}}** in the **{{Department}}** department since **{{JoiningDate}}**."},
 {"click": "main button:has-text('Add clause')", "after": 800},
 {"fill": "Clause 1", "sel": "main [aria-label='Clause 1']", "text": "The company has no objection to the employee obtaining a passport."},
 {"click": "main button:has-text('Add clause')", "after": 800},
 {"fill": "Clause 2", "sel": "main [aria-label='Clause 2']", "text": "This certificate is issued on the employee's request."},
 {"fill": "Signature Title", "sel": "main [aria-label='Signature Title']", "text": "Manager, HR & Compliance"},
 {"shot": "m1-noc-form"},
 {"click": "main button:has-text('Save template')", "after": 12000},
 {"texts": "versions", "of": "main tbody tr"},
 {"shot": "m2-noc-saved"},

 {"goto": "/hr-payroll/generate-letter"},
 {"wait": 20000},
 {"shot": "g0-initial"},
 {"fill": "Employee Number", "sel": "main [aria-label='Employee Number']", "text": "EMP-000005"},
 {"click": "main button:has-text('Search')", "after": 12000},
 {"fill": "Probation Period", "sel": "main [aria-label='Probation Period']", "text": "6"},
 {"shot": "g1-single"},
 {"printpdf": "main button:has-text('Print A4')", "as": "appointment-print"},
 {"wait": 10000},
 {"shot": "g2-printed"},
 {"pick": "Letter Type", "sel": "main [aria-label='Letter Type']", "option": "NOC Letter"},
 {"pick": "Employee", "sel": "main [aria-label='Employee']", "option": "All Employees"},
 {"click": "main button:has-text('Load Employees')", "after": 12000},
 {"shot": "g3-all-loaded"},
 {"click": "main button:has-text('Generate All')", "after": 15000},
 {"shot": "g4-all-generated"},

 {"goto": "/hr-payroll/letter-history"},
 {"wait": 20000},
 {"texts": "history", "of": "main tbody tr"},
 {"shot": "h0-history"},
 {"printpdf": "main tbody tr:first-child button:has-text('PDF')", "as": "history-pdf"},
 {"shot": "h1-after-pdf"},

 {"goto": "/hr-payroll/letter-reports"},
 {"wait": 20000},
 {"shot": "r0-reports"},
 {"printpdf": "main button:has-text('Print / PDF')", "as": "register-print"}
]
