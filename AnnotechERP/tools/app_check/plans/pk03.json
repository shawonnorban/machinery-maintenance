  "text": "31"
 },
 {
  "fill": "type",
  "sel": "main label:has-text('Carton Type') input",
  "text": "5-ply"
 },
 {
  "fill": "size",
  "sel": "main label:has-text('Carton Size') input",
  "text": "60x40x40 cm"
 },
 {
  "fill": "gross",
  "sel": "main label:has-text('Gross Wt') input",
  "text": "10.50"
 },
 {
  "fill": "net",
  "sel": "main label:has-text('Net Wt') input",
  "text": "9.80"
 },
 {
  "fill": "copies",
  "sel": "main label:has-text('No. of Cartons') input",
  "text": "2"
 },
 {
  "click": "main button:has-text('Create Carton(s)')",
  "after": 15000
 },
 {
  "texts": "ctn_note",
  "of": "main [role=status]"
 },
 {
  "texts": "ctn_rows",
  "of": "main tbody tr"
 },
 {
  "shot": "carton"
 },
 {
  "click": "main button:has-text('Complete Carton Packing')",
  "after": 15000
 },
 {
  "texts": "ctn_done",
  "of": "main p.text-success"
 },
 {
  "goto": "/assembly-floor/packing-carton-marking"
 },
 {
  "wait": 12000
 },
 {
  "fill": "find",
  "sel": "main input[id='pk-proc-find']",
  "text": "PKG-20261107-0001"
 },
 {
  "click": "main form button[aria-label='Scan']",
  "after": 12000
 },
 {
  "click": "main button:has-text('Start Carton Marking')",
