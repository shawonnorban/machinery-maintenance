[
 {
  "goto": "/assembly-floor/packing-carton"
 },
 {
  "wait": 12000
 },
 {
  "fill": "find",
  "sel": "main input[id='pk-proc-find']",
  "text": "PKG-20261107-0001"
 },
 {
  "click": "main form button[aria-label='Scan']",
  "after": 12000
 },
 {
  "click": "main button:has-text('Start Carton Packing')",
  "after": 15000
 },
 {
  "fill": "S",
