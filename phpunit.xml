<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Must have no path component: a subdirectory in APP_URL makes the test client prefix every route and match nothing. -->
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!--
            Null by default so no test reaches for a websocket server. The
            channel authorization tests switch to the real broadcaster for
            themselves, because the null one authorizes every channel for
            everybody and tests against it would pass without proving anything.
        -->
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="REVERB_APP_ID" value="testing"/>
        <env name="REVERB_APP_KEY" value="testing-key"/>
        <env name="REVERB_APP_SECRET" value="testing-secret"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Tests run against real MySQL: the schema depends on InnoDB, utf8mb4 and DECIMAL semantics that SQLite does not reproduce. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="machinery_maintenance_test"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
